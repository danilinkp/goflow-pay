SEED_COMPANIES=50
THINK_MIN=1
THINK_MAX=3
ACTIONS_PER_SESSION=3

RAMP_START_VUS="${RAMP_START_VUS:-100}"
RAMP_STEP_VUS="${RAMP_STEP_VUS:-100}"
RAMP_STEPS="${RAMP_STEPS:-6}"
RAMP_TRANSITION_DURATION="${RAMP_TRANSITION_DURATION:-0s}"
RAMP_STEP_DURATION="${RAMP_STEP_DURATION:-5s}"
RAMP_GRACEFUL_STOP="${RAMP_GRACEFUL_STOP:-0s}"

NORMAL_VUS=100
STRESS_VUS=300
STRESS_BASELINE=2m
STRESS_SPIKE_RAMP=30s
STRESS_HOLD=2m
STRESS_RECOVERY=5m

SOAK_VUS=100
SOAK_DURATION="${SOAK_DURATION:-20m}"

SESSION_PAUSE_MIN=2
SESSION_PAUSE_MAX=5
