          "expr": "sum by (svc) (label_replace(rate(container_blkio_device_usage_total{operation=\"Read\",container_label_com_docker_compose_service!=\"\"}[15s]), \"svc\", \"$1 read\", \"container_label_com_docker_compose_service\", \"(.*)\"))",
