      }
    },
    {
      "id": 10,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "type": "table",
      "title": "10. Распределение посекундного RPS",
      "datasource": {
        "type": "postgres",
        "uid": "resultsdb"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "WITH sec_rps AS (\n  SELECT date_trunc('second', ts) AS s, count(*) AS rps\n  FROM lr4_samples\n  WHERE testid = '$testid' AND metric = 'http_req_duration'\n  GROUP BY 1\n)\nSELECT\n  percentile_cont(0.50) WITHIN GROUP (ORDER BY rps) AS \"p50\",\n  percentile_cont(0.75) WITHIN GROUP (ORDER BY rps) AS \"p75\",\n  percentile_cont(0.90) WITHIN GROUP (ORDER BY rps) AS \"p90\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY rps) AS \"p95\",\n  percentile_cont(0.99) WITHIN GROUP (ORDER BY rps) AS \"p99\",\n  min(rps) AS \"min\",\n  max(rps) AS \"max\",\n  round(avg(rps)::numeric, 2) AS \"mean\"\nFROM sec_rps;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 11,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "type": "table",
      "title": "11. Сводка запросов и ошибок",
      "datasource": {
        "type": "postgres",
        "uid": "resultsdb"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  count(*) AS \"Всего запросов\",\n  count(*) FILTER (WHERE expected) AS \"Успешных / ожидаемых\",\n  count(*) FILTER (WHERE NOT expected) AS \"Неожиданных отказов\",\n  count(*) FILTER (WHERE kind = 'error') AS \"Ожидаемых ошибок\",\n  count(*) FILTER (WHERE status = 500 AND variant = 'overdraft') AS \"500 на overdraft (дефект)\",\n  count(*) FILTER (WHERE status = 500 AND (variant IS NULL OR variant != 'overdraft')) AS \"500 на прочих\"\nFROM lr4_samples\nWHERE testid = '$testid' AND metric = 'http_req_duration';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    },
