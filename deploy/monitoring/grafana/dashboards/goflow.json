          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{service=~\"alloy|loki|prometheus|grafana|cadvisor|nginx-exporter\"}[1m]))",
