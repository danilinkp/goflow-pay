    {
      "id": 12,
      "type": "timeseries",
      "title": "Нагрузка: сколько подавал k6 и сколько обработал стенд",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\",kind=\"read\"}[15s]))",
          "legendFormat": "k6 отправил чтений",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\",kind=\"write\"}[15s]))",
          "legendFormat": "k6 отправил записей",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(http_requests_total{stack=\"main\",route=~\"/api/.*\"}[30s]))",
          "legendFormat": "обработали gateway",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\",status=\"429\"}[15s]))",
          "legendFormat": "отклонено лимитом (429)",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(k6_dropped_iterations_total{testid=\"$testid\"}[15s]))",
          "legendFormat": "k6 не успел отправить",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "нет запросов за выбранный период"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Пока «отправил» и «обработали» совпадают, стенд справляется. Рост «не успел отправить» — стенд отвечает медленнее, чем подаётся нагрузка.",
      "interval": "5s"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Доля чтений каждого экземпляра (ожидается 50 / 25 / 25 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(http_requests_total{stack=\"main\",method=\"GET\",route=~\"/api/.*\"}[30s])) / ignoring(instance) group_left sum(rate(http_requests_total{stack=\"main\",method=\"GET\",route=~\"/api/.*\"}[30s]))",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 0.6,
          "decimals": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#6e7079",
                "value": 0.25
              },
              {
                "color": "#6e7079",
                "value": 0.5
              }
            ]
          },
          "unit": "percentunit",
          "noValue": "нет запросов за выбранный период"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Считается по счётчикам самих gateway (Prometheus). Пунктир — ожидаемые 25% и 50%. Ровные линии при любой нагрузке: round-robin не зависит от времени ответа.",
      "interval": "5s"
    },
