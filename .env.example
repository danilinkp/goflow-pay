# Скопируйте в .env (он в .gitignore) и задайте свои значения.

# Адрес и порт, на которых NGINX публикуется на хосте.
# По умолчанию только loopback; 0.0.0.0 откроет стенд в локальную сеть.
NGINX_BIND=127.0.0.1
NGINX_PORT=80

# Учётные данные HTTP Basic Auth для /admin.
# Если ADMIN_PASSWORD пустой, пароль сгенерируется при старте:
#   docker compose logs admin-htpasswd
ADMIN_USER=admin
ADMIN_PASSWORD=
