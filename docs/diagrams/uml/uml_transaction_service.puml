@startuml transaction_service
!theme plain
skinparam classBackgroundColor #f8f9fa
skinparam classBorderColor #495057
skinparam arrowColor #1168bd
skinparam packageBackgroundColor #e9ecef
skinparam packageBorderColor #adb5bd

title Диаграмма классов сервиса транзакций

package "domain" {
    enum TransactionStatus {
        PENDING
        PROCESSING
        COMPLETED
        FAILED
    }

    class Transaction {
        + ID
        + FromAccountID
        + ToAccountID
        + Amount
        + Status
        + IdempotencyKey
        + CreatedAt
        + UpdatedAt
    }

    class OutboxEvent {
        + ID
        + EventType
        + Payload
        + CreatedAt
        + SentAt
        + IsSent()
    }

    Transaction --> TransactionStatus
}

