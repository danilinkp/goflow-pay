package "service" {
    interface ITransactionRepository {
        + Save()
        + GetByID()
        + GetByIdempotencyKey()
        + UpdateStatus()
    }

    interface IOutboxRepository {
        + Save()
        + GetUnsent()
        + MarkAsSent()
    }

    interface IBalanceChecker {
        + CheckBalance()
    }

    interface IKafkaProducer {
        + Publish()
    }

    class TransactionService {
        - repo          : ITransactionRepository
        - outbox        : IOutboxRepository
        - balanceChecker: IBalanceChecker
        --
        + NewTransactionService()
        + CreateTransaction()
        + GetTransaction()
        - checkIdempotency()
        - validateAmount()
    }

    class OutboxWorker {
        - outbox   : IOutboxRepository
        - producer : IKafkaProducer
        - interval : time.Duration
        --
        + NewOutboxWorker()
        + Run()
        - processEvents()
    }

    TransactionService --> ITransactionRepository
    TransactionService --> IOutboxRepository
    TransactionService --> IBalanceChecker
    OutboxWorker --> IOutboxRepository
    OutboxWorker --> IKafkaProducer
'    TransactionService ..> CreateTransactionRequest
'    TransactionService ..> CreateTransactionResponse
'    TransactionService ..> GetTransactionRequest
'    TransactionService ..> GetTransactionResponse
}

package "repository" {
    class TransactionRepository {
        - db
        --
        + NewTransactionRepository()
        + Save()
        + GetByID()
        + GetByIdempotencyKey()
        + UpdateStatus()
    }

    class OutboxRepository {
        - db
        --
        + NewOutboxRepository()
        + Save()
        + GetUnsent()
        + MarkAsSent()
    }

    TransactionRepository ..|> ITransactionRepository
    OutboxRepository ..|> IOutboxRepository
}

package "client" {
    class AccountGRPCClient {
        - conn
        --
        + NewAccountGRPCClient()
        + CheckBalance()
    }

    AccountGRPCClient ..|> IBalanceChecker
}

package "handler" {
    class TransactionGRPCHandler {
        - service : *TransactionService
        --
        + NewTransactionGRPCHandler()
        + CreateTransaction()
        + GetTransaction()
    }

    TransactionGRPCHandler --> TransactionService
}

package "model" {
    class TransactionModel {
        + ID
        + FromAccountID
        + ToAccountID
        + Amount
        + Status
        + IdempotencyKey
        + CreatedAt
        + UpdatedAt
    }

    class OutboxModel {
        + ID
        + EventType
        + Payload
        + CreatedAt
        + SentAt
    }

    TransactionRepository ..> TransactionModel
    OutboxRepository ..> OutboxModel
    TransactionModel ..> Transaction
    OutboxModel ..> OutboxEvent
}

@enduml
