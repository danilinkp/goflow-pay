package "service" {
    interface IUserRepository {
        + Save(User)
        + GetByEmail(email)
        + GetByID(id)
    }

    interface ITokenBlacklist {
        + Add(token, ttl)
        + Exists(token)
    }

    class AuthService {
        - userRepo   : IUserRepository
        - blacklist  : ITokenBlacklist
        - jwtSecret  : string
        --
        + NewAuthService(repo, blacklist, secret)
        + Register(req)
        + Login(req)
        + ValidateToken(кeq)
        + Logout(token)
        - hashPassword(password)
        - generateJWT(user)
    }

    AuthService --> IUserRepository
    AuthService --> ITokenBlacklist
'    AuthService ..> RegisterRequest
'    AuthService ..> RegisterResponse
'    AuthService ..> LoginRequest
'    AuthService ..> LoginResponse
'    AuthService ..> ValidateTokenRequest
'    AuthService ..> ValidateTokenResponse
}

package "repository" {
    class UserRepository {
        - db
        --
        + NewUserRepository(db)
        + Save(user)
        + GetByEmail(email)
        + GetByID(id)
    }

    class TokenBlacklistRepository {
        - redis
        --
        + NewTokenBlacklistRepository(redis)
        + Add(token, ttl) :
        + Exists(ctx, token: string) : (bool, error)
    }

    UserRepository ..|> IUserRepository
    TokenBlacklistRepository ..|> ITokenBlacklist
}

package "handler" {
    class AuthGRPCHandler {
        - service : *AuthService
        --
        + NewAuthGRPCHandler()
        + Register(req)
        + Login(req)
        + ValidateToken(req)
        + Logout(req)
    }

    AuthGRPCHandler --> AuthService
}

package "model" {
    class UserModel {
        + ID
        + Email
        + PasswordHash
        + Role
        + CreatedAt
    }

    UserRepository ..> UserModel
    UserModel ..> User
}

@enduml
