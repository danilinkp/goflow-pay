@startuml auth_service
!theme plain
skinparam classBackgroundColor #f8f9fa
skinparam classBorderColor #495057
skinparam arrowColor #1168bd
skinparam packageBackgroundColor #e9ecef
skinparam packageBorderColor #adb5bd

title Диаграмма классов сервиса аутентификации

package "domain" {
    enum Role {
        GUEST
        USER
        ADMIN
    }

    class User {
        + ID
        + Email
        + PasswordHash
        + Role
        + CreatedAt
        + HasRole(required Role)
    }

    class ApiKey {
        + ID
        + UserID
        + KeyHash
        + CreatedAt
        + ExpiresAt
        + IsExpired()
    }

    User --> Role
    User "1" -- "0..*" ApiKey
}

