@startuml account_service
!theme plain
skinparam classBackgroundColor #f8f9fa
skinparam classBorderColor #495057
skinparam arrowColor #1168bd
skinparam packageBackgroundColor #e9ecef
skinparam packageBorderColor #adb5bd

title Диаграмма классов сервиса счетов

package "domain" {
    enum OperationType {
        DEPOSIT
        WITHDRAWAL
    }

    enum OperationStatus {
        PENDING
        COMPLETED
        FAILED
    }

    class Account {
        - id
        - companyId
        - balance
        - currency
        - createdAt
    }

    class BankAccount {
        - id
        - companyId
        - bankName
        - accountNumber
        - bik
        - createdAt
    }

    class BankOperation {
        - id
        - bankAccountId
        - accountId
        - type
        - amount
        - status
        - bankReference
        - createdAt
        - updatedAt
    }

    BankOperation --> OperationType
    BankOperation --> OperationStatus
    BankAccount "1" -- "0..*" BankOperation
    Account "1" -- "0..*" BankOperation
}

